/- Low-degree part of the gradient syzygy argument.
Regularity of the gradient is still a separate obligation. -/
module
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.Ideal.Span
import Lean.Elab.Tactic.Omega
import Mathlib.Tactic.Ring
@[expose] public section
noncomputable section
namespace NcCubic.GradientSyzygy
open MvPolynomial
variable {R σ : Type*} [CommRing R]

/-- Multiplication cannot create terms below a homogeneous factor's degree. -/
theorem coeff_mul_eq_zero_of_degree_lt {g : MvPolynomial σ R} {n : ℕ}
    (hg : g.IsHomogeneous n) (p : MvPolynomial σ R) (d : σ →₀ ℕ)
    (hd : d.degree < n) : (p * g).coeff d = 0 := by
  classical
  rw [coeff_mul]
  apply Finset.sum_eq_zero
  intro pair hp
  have heq := Finset.mem_antidiagonal.mp hp
  have hdeg : pair.1.degree + pair.2.degree = d.degree := by
    simpa using congrArg Finsupp.degree heq
  rw [hg.coeff_eq_zero (by omega), mul_zero]

/-- Every element of an ideal generated by degree-n forms has no lower terms. -/
theorem coeff_eq_zero_of_mem_span_homogeneous {ι : Type*}
    (g : ι → MvPolynomial σ R) {n : ℕ} (hg : ∀ i, (g i).IsHomogeneous n)
    {p : MvPolynomial σ R} (hp : p ∈ Ideal.span (Set.range g))
    (d : σ →₀ ℕ) (hd : d.degree < n) : p.coeff d = 0 := by
  classical
  suffices h : ∀ e : σ →₀ ℕ, e.degree < n → p.coeff e = 0 from h d hd
  induction hp using Submodule.span_induction with
  | mem p hp =>
      intro d hd
      obtain ⟨i, rfl⟩ := hp
      exact (hg i).coeff_eq_zero (by omega)
  | zero => simp
  | add p q hp hq ihp ihq =>
      intro d hd
      simp [ihp d hd, ihq d hd]
  | smul a p hp ih =>
      intro d hd
      change (a * p).coeff d = 0
      rw [coeff_mul]
      apply Finset.sum_eq_zero
      intro pair hpair
      have heq := Finset.mem_antidiagonal.mp hpair
      have hdeg : pair.1.degree + pair.2.degree = d.degree := by
        simpa using congrArg Finsupp.degree heq
      rw [ih pair.2 (by omega), mul_zero]
/-- An ideal generated in degree n contains no nonzero polynomial of smaller total degree. -/
theorem eq_zero_of_mem_span_homogeneous_of_totalDegree_lt {ι : Type*}
    (g : ι → MvPolynomial σ R) {n : ℕ} (hg : ∀ i, (g i).IsHomogeneous n)
    {p : MvPolynomial σ R} (hp : p ∈ Ideal.span (Set.range g))
    (hdeg : p.totalDegree < n) : p = 0 := by
  classical
  ext d
  change p.coeff d = 0
  by_cases hd : d.degree < n
  · exact coeff_eq_zero_of_mem_span_homogeneous g hg hp d hd
  · apply coeff_eq_zero_of_totalDegree_lt
    change p.totalDegree < d.degree
    omega
/-- Each coordinate of a combination of Koszul relations belongs to the generator ideal. -/
theorem coordinate_mem_ideal_of_mem_relation_span {ι : Type*} [DecidableEq ι]
    (g : ι → MvPolynomial σ R) {a : ι → MvPolynomial σ R}
    (ha : a ∈ Submodule.span (MvPolynomial σ R)
      (Set.range fun ij : ι × ι => Pi.single ij.2 (g ij.1) - Pi.single ij.1 (g ij.2)))
    (i : ι) : a i ∈ Ideal.span (Set.range g) := by
  classical
  induction ha using Submodule.span_induction with
  | mem a ha =>
      obtain ⟨⟨j,k⟩,rfl⟩ := ha
      change (Pi.single k (g j) : ι → MvPolynomial σ R) i -
        (Pi.single j (g k) : ι → MvPolynomial σ R) i ∈ _
      apply Ideal.sub_mem
      · by_cases h : k = i
        · subst k; simpa using (Ideal.subset_span (Set.mem_range_self j))
        · simp [h]
      · by_cases h : j = i
        · subst j; simpa using (Ideal.subset_span (Set.mem_range_self k))
        · simp [h]
  | zero => simp
  | add a b ha hb iha ihb => exact Ideal.add_mem _ iha ihb
  | smul c a ha ih => exact Ideal.mul_mem_left _ c ih

/-- The degree argument for first syzygies. The hypothesis that all syzygies
are Koszul relations must be supplied by regularity; it is not assumed implicitly. -/
theorem eq_zero_of_mem_relation_span_of_totalDegree_lt {ι : Type*} [DecidableEq ι]
    (g : ι → MvPolynomial σ R) {n : ℕ} (hg : ∀ i, (g i).IsHomogeneous n)
    {a : ι → MvPolynomial σ R}
    (ha : a ∈ Submodule.span (MvPolynomial σ R)
      (Set.range fun ij : ι × ι => Pi.single ij.2 (g ij.1) - Pi.single ij.1 (g ij.2)))
    (hdeg : ∀ i, (a i).totalDegree < n) : a = 0 := by
  funext i
  exact eq_zero_of_mem_span_homogeneous_of_totalDegree_lt g hg
    (coordinate_mem_ideal_of_mem_relation_span g ha i) (hdeg i)
/-- A unit generator makes every first relation a Koszul relation. This is the
local argument used away from the common zero locus. -/
theorem mem_relation_span_of_isUnit {ι : Type*} [Fintype ι] [DecidableEq ι]
    (g : ι → MvPolynomial σ R) (j : ι) (hunit : IsUnit (g j))
    (a : ι → MvPolynomial σ R) (ha : ∑ i, a i * g i = 0) :
    a ∈ Submodule.span (MvPolynomial σ R)
      (Set.range fun ij : ι × ι => Pi.single ij.2 (g ij.1) - Pi.single ij.1 (g ij.2)) := by
  classical
  obtain ⟨u, hu⟩ := hunit.exists_left_inv
  let rel : ι → (ι → MvPolynomial σ R) :=
    fun i => Pi.single i (g j) - Pi.single j (g i)
  have heq : a = ∑ i, (u * a i) • rel i := by
    funext k
    simp only [Finset.sum_apply, Pi.smul_apply, rel, Pi.sub_apply, smul_eq_mul]
    simp only [mul_sub, Finset.sum_sub_distrib]
    simp only [Pi.single_apply, mul_ite, mul_zero]
    simp only [Finset.sum_ite_eq, Finset.mem_univ, ite_true]
    have hz : (∑ x, if k = j then u * a x * g x else 0) = 0 := by
      by_cases h : k = j
      · simp only [h, ite_true, mul_assoc, ← Finset.mul_sum, ha, mul_zero]
      · simp [h]
    rw [hz, sub_zero]
    calc
      a k = (u * g j) * a k := by rw [hu, one_mul]
      _ = u * a k * g j := by ring
  rw [heq]
  apply Submodule.sum_mem
  intro i hi
  apply Submodule.smul_mem
  exact Submodule.subset_span ⟨(j,i), rfl⟩
end NcCubic.GradientSyzygy
